# Copy to .env and fill in. Never commit .env.
#
# Warrant fails closed: if the model is unavailable or a key is missing, the
# verdict is ESCALATE, never ALLOW. An unset key degrades the service, it does
# not disable the check.

ANTHROPIC_API_KEY=

# Model used for constraint extraction (C2) and attribute conformance (C4.2)
WARRANT_MODEL=claude-sonnet-5

# Local embedding model for category mapping (C4.1). No network in the hot path.
WARRANT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Evidence log
WARRANT_DB_PATH=data/warrant.db
