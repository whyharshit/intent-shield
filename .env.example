# Copy to .env and fill in. Never commit .env.
#
# Warrant fails closed: with no key configured the semantic checker returns
# `not_determinable` for every soft constraint and the cart ESCALATES. It never
# falls back to ALLOW. A missing key degrades the service; it never silently
# weakens it.


# --- Semantic checker (C4 stage 2) — the only component that calls a model ---

# Google Gemini. https://aistudio.google.com/apikey
# Several comma-separated keys are supported and rotated: the free tier caps
# requests per minute, a full evaluation is ~2,400 calls, and rotating across
# N keys multiplies the ceiling.
GEMINI_API_KEY=

# Anthropic. Optional. Leave blank to run Gemini-only.
# Wiring both lets the eval report a cross-provider agreement rate, which
# 05-roadmap.md lists as cheap robustness evidence.
ANTHROPIC_API_KEY=

# gemini | anthropic | auto   (auto prefers gemini when both are present)
WARRANT_PROVIDER=auto

# gemini-flash-lite-latest returns in ~1.5s against ~17s for gemini-3.6-flash
# on this workload, with no measured loss on the attribute task. At ~2,400
# calls that is the difference between an hour and eleven.
WARRANT_GEMINI_MODEL=gemini-flash-lite-latest
WARRANT_ANTHROPIC_MODEL=claude-opus-5


# --- Local, no credentials needed ---

# Category mapping (C4 stage 1) runs locally — no network in the hot path.
WARRANT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Evidence log
WARRANT_DB_PATH=data/warrant.db
